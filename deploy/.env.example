# 复制成 .env 并 chmod 600。

# 飞书应用机器人（开放平台自建应用，需开通「以应用身份发消息」）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me
# 收件人：user:ou_xxx（私聊）/ chat:oc_xxx（群）/ email:xxx
PUSHME_TO=user:ou_xxxxxxxxxxxxxxxx

# 调用方清单 name:token，逗号分隔；token 用 `openssl rand -hex 24` 生成，至少 16 位。
# 消息前会加「[name]」；删掉一项即吊销该调用方。
PUSHME_TOKENS=openwrt:replace-me,acme:replace-me

# 每个调用方的限流（可选，默认 30/10m）
#PUSHME_RATE=30/10m

# 端口绑定（compose 插值用）：部署机内网 IP 与宿主端口
PUSHME_BIND=127.0.0.1
PUSHME_PORT=8290
